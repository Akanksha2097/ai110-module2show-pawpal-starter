classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet)
        +remove_pet(pet_name)
        +get_pet(pet_name) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task)
        +remove_task(task)
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str description
        +datetime due_time
        +str frequency
        +str pet_name
        +bool completed
        +mark_complete()
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_by_pet(pet_name) list~Task~
        +filter_by_status(completed) list~Task~
        +find_conflicts() list
        +complete_task(task)
    }
    
    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : reads tasks via